rules_version = '2';

// Dokan rules — complete (steps 1–11): profiles, shops, roles, invites, locations, catalogue, stock,
// buying, selling, pricing, money, backups.
// Every shop's data lives under shops/{shopId}; access needs an active member document there.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    function shopPath(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function memberPath(shopId) { return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid); }
    function invitePath(shopId, code) { return /databases/$(database)/documents/shops/$(shopId)/invites/$(code); }
    function member(shopId) { return get(memberPath(shopId)).data; }

    function isMember(shopId) {
      return signedIn() && exists(memberPath(shopId)) && member(shopId).disabled != true;
    }
    function hasRole(shopId, roles) { return isMember(shopId) && member(shopId).role in roles; }
    function isOwner(shopId) { return hasRole(shopId, ['owner']); }
    function isManager(shopId) { return hasRole(shopId, ['owner', 'manager']); }
    // Owners, and managers allowed to see costs.
    function isCostManager(shopId) {
      return isManager(shopId) && (member(shopId).role == 'owner' || member(shopId).get('canSeeCosts', false) == true);
    }

    // During a restore, clear or shop deletion the owner sets shops/{id}.restoreUntil a few minutes
    // ahead; until then the owner may rewrite any document of the shop, including history.
    function restoring(shopId) {
      return isOwner(shopId)
        && get(shopPath(shopId)).data.get('restoreUntil', null) is timestamp
        && get(shopPath(shopId)).data.restoreUntil > request.time;
    }

    // True while the shop is being created in this same batch by the current user.
    function creatingShop(shopId) {
      return signedIn()
        && !exists(shopPath(shopId))
        && getAfter(shopPath(shopId)).data.ownerId == request.auth.uid;
    }

    // Membership being created from an unused, unexpired invite that this batch marks as used.
    function joiningByInvite(shopId) {
      let d = request.resource.data;
      let p = invitePath(shopId, d.inviteCode);
      let inv = get(p).data;
      return d.inviteCode is string
        && exists(p)
        && inv.usedBy == null
        && inv.expiresAt > request.time
        && getAfter(p).data.usedBy == request.auth.uid
        && d.role == inv.role
        && d.branchIds == inv.branchIds
        && d.canSeeCosts == inv.canSeeCosts
        && d.disabled == false;
    }

    function validAccess(d) {
      return d.role in ['manager', 'employee']
        && d.branchIds is list
        && d.canSeeCosts is bool
        && (d.role == 'manager' || d.branchIds.size() > 0);
    }

    // ---------- User profiles ----------
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'lang', 'digits', 'shopIds', 'lastShopId', 'createdAt', 'updatedAt'])
        && request.resource.data.shopIds is list;
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'lang', 'digits', 'shopIds', 'lastShopId', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- Invite code lookup: says which shop a code belongs to ----------
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isOwner(request.resource.data.shopId)
        && existsAfter(invitePath(request.resource.data.shopId, code));
      allow update: if false;
      allow delete: if signedIn() && isOwner(resource.data.shopId);
    }

    // ---------- Shops ----------
    match /shops/{shopId} {
      allow read: if isMember(shopId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(memberPath(shopId)).data.role == 'owner';
      allow update: if (isOwner(shopId) && request.resource.data.ownerId == resource.data.ownerId)
        // Managers save the day's USD rate into the settings, and nothing else.
        || (isManager(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settings', 'updatedAt'])
          && request.resource.data.settings.diff(resource.data.get('settings', {})).affectedKeys()
               .hasOnly(['usdRate', 'rateDate', 'rateSource', 'rateManual']));
      allow delete: if isOwner(shopId);

      match /members/{uid} {
        // Members can always read their own document, even when disabled.
        allow read: if isMe(uid) || isManager(shopId);
        allow create: if isMe(uid)
          && request.resource.data.uid == uid
          && (
            (creatingShop(shopId) && request.resource.data.role == 'owner' && request.resource.data.disabled == false)
            || joiningByInvite(shopId)
          );
        // Only the owner changes roles, locations, cost access and disabling — never their own.
        allow update: if isOwner(shopId) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'branchIds', 'canSeeCosts', 'disabled', 'updatedAt'])
          && validAccess(request.resource.data)
          && request.resource.data.disabled is bool;
        allow delete: if (isOwner(shopId) && uid != request.auth.uid)
          // The owner's own membership is removed last, once the shop itself is deleted.
          || (isMe(uid) && !exists(shopPath(shopId)));
      }

      match /invites/{code} {
        // Knowing the code is what lets someone read it; nobody can list codes except the owner.
        allow get: if signedIn();
        allow list: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && request.resource.data.code == code
          && request.resource.data.shopId == shopId
          && request.resource.data.usedBy == null
          && validAccess(request.resource.data)
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
        // The joining user marks it used, in the same batch that creates their membership.
        allow update: if signedIn()
          && resource.data.usedBy == null
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && existsAfter(memberPath(shopId));
        allow delete: if isOwner(shopId);
      }

      match /locations/{locId} {
        allow read: if isMember(shopId);
        allow create: if isManager(shopId) || creatingShop(shopId);
        allow update: if isManager(shopId);
        allow delete: if isOwner(shopId);
      }

      // Everyone in the shop reads the catalogue; owners and managers change it.
      match /categories/{catId} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId) && validCategory(request.resource.data);
        allow delete: if isManager(shopId);
      }

      match /products/{productId} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId) && validProduct(request.resource.data);
        allow delete: if isManager(shopId);
      }

      // Stock quantities per location: { qty: { locationId: n } }. The app always changes them in the
      // same batch as a movement; the rules allow only the locations the member may use. Never deleted.
      // Employees change stock too, by receiving goods (and selling, from step 6).
      match /stock/{productId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && validStock(request.resource.data)
          && inMyLocations(shopId, request.resource.data.qty.keys());
        allow update: if isMember(shopId) && validStock(request.resource.data)
          && inMyLocations(shopId, request.resource.data.qty.diff(resource.data.get('qty', {})).affectedKeys());
        allow delete: if false;
      }

      // Movements are the stock history: created once, never changed or deleted.
      match /movements/{moveId} {
        allow read: if isMember(shopId);
        allow create: if isMember(shopId) && validMove(shopId, request.resource.data);
        allow update, delete: if false;
      }

      // Purchases. Employees record receipts with quantities only and can read them until a
      // manager adds prices. Costed invoices are locked.
      match /purchases/{purchaseId} {
        allow read: if isCostManager(shopId)
          || (isMember(shopId)
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'received'
            && resource.data.costsEntered == false);
        allow create: if isMember(shopId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'received'
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0
          && inMyLocations(shopId, [request.resource.data.locationId])
          && (isCostManager(shopId) || request.resource.data.costsEntered == false);
        allow update: if isCostManager(shopId)
          && resource.data.status == 'received'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.locationId == resource.data.locationId
          && request.resource.data.number == resource.data.number;
        allow delete: if false;
      }

      // Average cost per product, and its history per purchase. Hidden from anyone without cost access.
      match /costs/{productId} {
        allow read, create, update: if isCostManager(shopId);
        allow delete: if false;
        match /history/{purchaseId} {
          allow read, create: if isCostManager(shopId);
          allow update, delete: if false;
        }
      }

      // Supplier contact details: everyone reads (for receipts), managers edit, nobody deletes.
      match /suppliers/{supplierId} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId)
          && request.resource.data.name is string && request.resource.data.name.size() > 0;
        allow delete: if false;
      }

      // What we owe each supplier.
      match /supplierAccounts/{supplierId} {
        allow read, create, update: if isCostManager(shopId);
        allow delete: if false;
      }

      match /supplierPayments/{entryId} {
        allow read: if isCostManager(shopId);
        allow create: if isCostManager(shopId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.kind in ['payment', 'charge']
          && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update, delete: if false;
      }

      match /stockCounts/{countId} {
        allow read: if isManager(shopId);
        allow create: if isManager(shopId)
          && request.resource.data.status == 'open'
          && request.resource.data.createdBy == request.auth.uid
          && inMyLocations(shopId, [request.resource.data.locationId]);
        allow update: if isManager(shopId)
          && inMyLocations(shopId, [resource.data.locationId])
          && resource.data.status == 'open'
          && request.resource.data.locationId == resource.data.locationId;
        allow delete: if isManager(shopId) && inMyLocations(shopId, [resource.data.locationId]);
      }

      // Sales and returns: created by any member at their own locations, never changed or deleted.
      // Members limited to some locations only read those (queries must filter by locationId).
      match /sales/{saleId} {
        allow read: if isMember(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create: if isMember(shopId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && inMyLocations(shopId, [request.resource.data.locationId])
          && request.resource.data.lines is list && request.resource.data.lines.size() > 0
          && request.resource.data.total is number && request.resource.data.total >= 0
          && request.resource.data.onCredit is number
          && (request.resource.data.onCredit <= 0 || request.resource.data.customerId is string);
        allow update, delete: if false;
      }

      match /returns/{returnId} {
        allow read: if isMember(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create: if isMember(shopId)
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at == request.time
          && inMyLocations(shopId, [request.resource.data.locationId])
          && request.resource.data.amount is number && request.resource.data.amount >= 0;
        allow update, delete: if false;
      }

      // Customers: every member can add one at the till and see balances (to sell on credit).
      match /customers/{customerId} {
        allow read: if isMember(shopId);
        allow create, update: if isMember(shopId)
          && request.resource.data.name is string && request.resource.data.name.size() > 0;
        allow delete: if false;
      }

      match /customerAccounts/{customerId} {
        allow read: if isMember(shopId);
        allow create, update: if isMember(shopId) && request.resource.data.keys().hasOnly(['balance', 'updatedAt'])
          && request.resource.data.balance is number;
        allow delete: if false;
      }

      // Payments received from customers, and (managers only) opening balances or corrections.
      match /customerPayments/{entryId} {
        allow read: if isMember(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create: if isMember(shopId)
          && request.resource.data.by == request.auth.uid
          && inMyLocations(shopId, [request.resource.data.locationId])
          && request.resource.data.amount is number && request.resource.data.amount > 0
          && (request.resource.data.kind == 'payment' || (request.resource.data.kind == 'charge' && isManager(shopId)));
        allow update, delete: if false;
      }

      // Day totals per location, for the dashboard. Only ever increased or decreased in the same
      // batch as a sale, return or payment.
      match /dailyStats/{statId} {
        allow read: if isMember(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create, update: if isMember(shopId)
          && inMyLocations(shopId, [request.resource.data.locationId])
          && statId == request.resource.data.locationId + '_' + request.resource.data.date
          && request.resource.data.keys().hasOnly(['locationId', 'date', 'sales', 'count', 'returns', 'credit', 'expenses', 'pay', 'collected', 'paidOut', 'items', 'updatedAt']);
        allow delete: if false;
      }
      // USD rate history, one document per day.
      match /fxRates/{date} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId)
          && request.resource.data.date == date
          && request.resource.data.rate is number && request.resource.data.rate > 0;
        allow delete: if false;
      }

      // Expenses per branch: managers record them for their locations; only the owner deletes.
      match /expenses/{expenseId} {
        allow read: if isManager(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create: if isManager(shopId)
          && request.resource.data.by == request.auth.uid
          && inMyLocations(shopId, [request.resource.data.locationId])
          && request.resource.data.amount is number && request.resource.data.amount > 0;
        allow update: if false;
        allow delete: if isOwner(shopId);
      }

      // Cash drawer per branch per day. Anyone at the branch opens and closes it;
      // only owners and managers can reopen a closed day.
      match /cashDays/{dayId} {
        allow read: if isMember(shopId) && canSeeLocation(shopId, resource.data.locationId);
        allow create: if isMember(shopId)
          && inMyLocations(shopId, [request.resource.data.locationId])
          && dayId == request.resource.data.locationId + '_' + request.resource.data.date
          && request.resource.data.opening is number;
        allow update: if isMember(shopId)
          && inMyLocations(shopId, [resource.data.locationId])
          && request.resource.data.locationId == resource.data.locationId
          && request.resource.data.date == resource.data.date
          && (resource.data.closedAt == null || isManager(shopId));
        allow delete: if false;
      }

      // Cloud backups: owner only. The JSON is split over chunks/{n}.
      match /backups/{backupId} {
        allow read, write: if isOwner(shopId);
        match /chunks/{chunkId} {
          allow read, write: if isOwner(shopId);
        }
      }

      // Restore window: the owner may rewrite anything in the shop for a few minutes.
      match /{collectionName}/{docId} {
        allow read, write: if restoring(shopId);
      }
      match /costs/{productId}/history/{historyId} {
        allow read, write: if restoring(shopId);
      }
      // Collections not listed here are closed by default.
    }

    // Owners, and managers without a location list, may use every location.
    function seesAllLocations(shopId) {
      let m = member(shopId);
      return m.role == 'owner' || (m.role == 'manager' && m.branchIds.size() == 0);
    }
    function inMyLocations(shopId, ids) {
      return seesAllLocations(shopId) || ids.hasOnly(member(shopId).branchIds);
    }
    // For reads: written so Firestore can check queries filtered by locationId.
    function canSeeLocation(shopId, locId) {
      return seesAllLocations(shopId) || locId in member(shopId).branchIds;
    }

    function validStock(d) {
      return d.keys().hasOnly(['qty', 'updatedAt']) && d.qty is map;
    }

    function validMove(shopId, d) {
      return d.by == request.auth.uid
        // Every member sells, returns and receives goods; managers also adjust, transfer and count.
        && (d.type in ['purchase', 'sale', 'return'] || (isManager(shopId) && d.type in ['adjust', 'transfer', 'count']))
        && d.productId is string
        && d.qty is number && d.qty > 0
        && d.locations is list && d.locations.size() > 0 && d.locations.size() <= 2
        && d.at == request.time
        && inMyLocations(shopId, d.locations);
    }

    function optionalPct(v) { return v == null || (v is number && v >= 0 && v <= 1000); }

    function validCategory(d) {
      return d.nameAr is string && d.nameAr.size() > 0
        && d.nameEn is string
        && (d.get('parentId', null) == null || d.parentId is string)
        && optionalPct(d.get('markupPct', null));
    }

    function validProduct(d) {
      return d.nameAr is string && d.nameAr.size() > 0 && d.nameAr.size() <= 200
        && d.nameEn is string && d.nameEn.size() <= 200
        && (d.get('categoryId', null) == null || d.categoryId is string)
        && d.unit is string
        && (d.get('price', null) == null || (d.price is number && d.price >= 0))
        && optionalPct(d.get('markupPct', null))
        && d.lowStock is map
        && d.active is bool;
    }
  }
}
