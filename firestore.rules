rules_version = '2';

// Dokan rules — step 4: profiles, shops, members and roles, invites, locations, catalogue, stock.
// Every shop's data lives under shops/{shopId}; access needs an active member document there.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }

    function shopPath(shopId) { return /databases/$(database)/documents/shops/$(shopId); }
    function memberPath(shopId) { return /databases/$(database)/documents/shops/$(shopId)/members/$(request.auth.uid); }
    function invitePath(shopId, code) { return /databases/$(database)/documents/shops/$(shopId)/invites/$(code); }
    function member(shopId) { return get(memberPath(shopId)).data; }

    function isMember(shopId) {
      return signedIn() && exists(memberPath(shopId)) && member(shopId).disabled != true;
    }
    function hasRole(shopId, roles) { return isMember(shopId) && member(shopId).role in roles; }
    function isOwner(shopId) { return hasRole(shopId, ['owner']); }
    function isManager(shopId) { return hasRole(shopId, ['owner', 'manager']); }

    // True while the shop is being created in this same batch by the current user.
    function creatingShop(shopId) {
      return signedIn()
        && !exists(shopPath(shopId))
        && getAfter(shopPath(shopId)).data.ownerId == request.auth.uid;
    }

    // Membership being created from an unused, unexpired invite that this batch marks as used.
    function joiningByInvite(shopId) {
      let d = request.resource.data;
      let p = invitePath(shopId, d.inviteCode);
      let inv = get(p).data;
      return d.inviteCode is string
        && exists(p)
        && inv.usedBy == null
        && inv.expiresAt > request.time
        && getAfter(p).data.usedBy == request.auth.uid
        && d.role == inv.role
        && d.branchIds == inv.branchIds
        && d.canSeeCosts == inv.canSeeCosts
        && d.disabled == false;
    }

    function validAccess(d) {
      return d.role in ['manager', 'employee']
        && d.branchIds is list
        && d.canSeeCosts is bool
        && (d.role == 'manager' || d.branchIds.size() > 0);
    }

    // ---------- User profiles ----------
    match /users/{uid} {
      allow read: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'lang', 'digits', 'shopIds', 'lastShopId', 'createdAt', 'updatedAt'])
        && request.resource.data.shopIds is list;
      allow update: if isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'lang', 'digits', 'shopIds', 'lastShopId', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- Invite code lookup: says which shop a code belongs to ----------
    match /inviteCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isOwner(request.resource.data.shopId)
        && existsAfter(invitePath(request.resource.data.shopId, code));
      allow update: if false;
      allow delete: if signedIn() && isOwner(resource.data.shopId);
    }

    // ---------- Shops ----------
    match /shops/{shopId} {
      allow read: if isMember(shopId);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && getAfter(memberPath(shopId)).data.role == 'owner';
      allow update: if isOwner(shopId)
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isOwner(shopId);

      match /members/{uid} {
        // Members can always read their own document, even when disabled.
        allow read: if isMe(uid) || isManager(shopId);
        allow create: if isMe(uid)
          && request.resource.data.uid == uid
          && (
            (creatingShop(shopId) && request.resource.data.role == 'owner' && request.resource.data.disabled == false)
            || joiningByInvite(shopId)
          );
        // Only the owner changes roles, locations, cost access and disabling — never their own.
        allow update: if isOwner(shopId) && uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'branchIds', 'canSeeCosts', 'disabled', 'updatedAt'])
          && validAccess(request.resource.data)
          && request.resource.data.disabled is bool;
        allow delete: if isOwner(shopId) && uid != request.auth.uid;
      }

      match /invites/{code} {
        // Knowing the code is what lets someone read it; nobody can list codes except the owner.
        allow get: if signedIn();
        allow list: if isOwner(shopId);
        allow create: if isOwner(shopId)
          && request.resource.data.code == code
          && request.resource.data.shopId == shopId
          && request.resource.data.usedBy == null
          && validAccess(request.resource.data)
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt < request.time + duration.value(8, 'd');
        // The joining user marks it used, in the same batch that creates their membership.
        allow update: if signedIn()
          && resource.data.usedBy == null
          && resource.data.expiresAt > request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt'])
          && request.resource.data.usedBy == request.auth.uid
          && existsAfter(memberPath(shopId));
        allow delete: if isOwner(shopId);
      }

      match /locations/{locId} {
        allow read: if isMember(shopId);
        allow create: if isManager(shopId) || creatingShop(shopId);
        allow update: if isManager(shopId);
        allow delete: if isOwner(shopId);
      }

      // Everyone in the shop reads the catalogue; owners and managers change it.
      match /categories/{catId} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId) && validCategory(request.resource.data);
        allow delete: if isManager(shopId);
      }

      match /products/{productId} {
        allow read: if isMember(shopId);
        allow create, update: if isManager(shopId) && validProduct(request.resource.data);
        allow delete: if isManager(shopId);
      }

      // Stock quantities per location: { qty: { locationId: n } }. The app always changes them in the
      // same batch as a movement; the rules allow only the locations the member may use. Never deleted.
      match /stock/{productId} {
        allow read: if isMember(shopId);
        allow create: if isManager(shopId) && validStock(request.resource.data)
          && inMyLocations(shopId, request.resource.data.qty.keys());
        allow update: if isManager(shopId) && validStock(request.resource.data)
          && inMyLocations(shopId, request.resource.data.qty.diff(resource.data.get('qty', {})).affectedKeys());
        allow delete: if false;
      }

      // Movements are the stock history: created once, never changed or deleted.
      match /movements/{moveId} {
        allow read: if isMember(shopId);
        allow create: if isManager(shopId) && validMove(shopId, request.resource.data);
        allow update, delete: if false;
      }

      match /stockCounts/{countId} {
        allow read: if isManager(shopId);
        allow create: if isManager(shopId)
          && request.resource.data.status == 'open'
          && request.resource.data.createdBy == request.auth.uid
          && inMyLocations(shopId, [request.resource.data.locationId]);
        allow update: if isManager(shopId)
          && inMyLocations(shopId, [resource.data.locationId])
          && resource.data.status == 'open'
          && request.resource.data.locationId == resource.data.locationId;
        allow delete: if isManager(shopId) && inMyLocations(shopId, [resource.data.locationId]);
      }
      // Collections not listed here are closed by default.
    }

    // Owners, and managers without a location list, may use every location.
    function seesAllLocations(shopId) {
      let m = member(shopId);
      return m.role == 'owner' || (m.role == 'manager' && m.branchIds.size() == 0);
    }
    function inMyLocations(shopId, ids) {
      return seesAllLocations(shopId) || ids.hasOnly(member(shopId).branchIds);
    }

    function validStock(d) {
      return d.keys().hasOnly(['qty', 'updatedAt']) && d.qty is map;
    }

    function validMove(shopId, d) {
      return d.by == request.auth.uid
        && d.type in ['adjust', 'transfer', 'count']
        && d.productId is string
        && d.qty is number && d.qty > 0
        && d.locations is list && d.locations.size() > 0 && d.locations.size() <= 2
        && d.at == request.time
        && inMyLocations(shopId, d.locations);
    }

    function optionalPct(v) { return v == null || (v is number && v >= 0 && v <= 1000); }

    function validCategory(d) {
      return d.nameAr is string && d.nameAr.size() > 0
        && d.nameEn is string
        && (d.get('parentId', null) == null || d.parentId is string)
        && optionalPct(d.get('markupPct', null));
    }

    function validProduct(d) {
      return d.nameAr is string && d.nameAr.size() > 0 && d.nameAr.size() <= 200
        && d.nameEn is string && d.nameEn.size() <= 200
        && (d.get('categoryId', null) == null || d.categoryId is string)
        && d.unit is string
        && (d.get('price', null) == null || (d.price is number && d.price >= 0))
        && optionalPct(d.get('markupPct', null))
        && d.lowStock is map
        && d.active is bool;
    }
  }
}
